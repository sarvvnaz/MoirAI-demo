{
  "manifest_version": 3,
  "name": "Wikipedia Only Overlay",
  "version": "1.0",
  "description": "Shows an overlay whenever the active tab is not Wikipedia.",

  "permissions": ["tabs", "scripting", "storage"],

  "host_permissions": ["<all_urls>"],

  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },

  "background": {
    "service_worker": "background.js"
  }
}